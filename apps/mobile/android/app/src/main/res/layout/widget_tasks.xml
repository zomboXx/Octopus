<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="3dp">
    <LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="170dp"
        android:layout_gravity="center" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp"
        android:background="@drawable/widget_background" android:elevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp"
                android:background="@drawable/widget_pill" android:src="@drawable/widget_trend_icon" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhịp hôm nay"
                    android:textColor="@color/widget_ink" android:textSize="13.5sp" android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="Chưa có việc hôm nay" android:textSize="9sp" android:fontFamily="sans-serif"
                    android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="28dp"
                android:paddingHorizontal="9dp" android:gravity="center" android:background="@drawable/widget_pill"
                android:text="+ Thêm" android:textColor="@color/widget_blue" android:fontFamily="sans-serif-medium" android:textSize="10sp"
                android:includeFontPadding="false" android:contentDescription="Thêm việc" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_current" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="48dp" android:layout_marginTop="10dp" android:layout_marginBottom="9dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_tile">
            <ImageButton android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="match_parent"
                android:padding="12dp" android:src="@drawable/widget_check_icon" android:scaleType="fitCenter"
                android:background="@android:color/transparent" android:contentDescription="Hoàn thành việc hiện tại" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/widget_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="HÔM NAY" android:textSize="8.5sp" android:textColor="@color/widget_blue"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="3dp" android:textColor="@color/widget_muted" android:textSize="9sp"
                        android:fontFamily="sans-serif" android:includeFontPadding="false" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Chọn một việc quan trọng" android:textColor="@color/widget_ink"
                    android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <ImageButton android:id="@+id/widget_open" android:layout_width="30dp" android:layout_height="30dp"
                android:layout_marginHorizontal="9dp" android:padding="8dp" android:src="@drawable/widget_next_icon"
                android:background="@drawable/widget_circle" android:contentDescription="Xem công việc" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2FA" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/widget_next_row" android:layout_width="match_parent" android:layout_height="24dp"
            android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/widget_clock_icon" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:text="Thêm việc cho ngày của bạn" android:textSize="10.5sp" android:fontFamily="sans-serif"
                android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="5dp"
                android:src="@drawable/widget_next_icon" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
